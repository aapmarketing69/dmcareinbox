# =============================================================================
# DmCare Inbox — Environment Configuration
# =============================================================================

# Mode ("development" locally, "production" on Railway)
NODE_ENV=development
BRAND_NAME=DmCare
PORT=3000
HOST=127.0.0.1

# Database
# - Leave DATABASE_URL blank to use local SQLite (./data/omnichannel.db)
# - On Railway, adding PostgreSQL automatically provides DATABASE_URL
DATABASE_URL=
DB_PATH=./data/omnichannel.db

# Security Secrets (generate strong 32+ char random strings for Production!)
ENCRYPTION_KEY=change-this-to-a-strong-32-byte-secret-in-production
SESSION_SECRET=change-this-to-another-strong-session-signing-secret

# Public HTTPS URL of this app (Railway domain or custom domain, no trailing slash)
PUBLIC_BASE_URL=

# Initial Owner/Supervisor Account (used when initializing a fresh database)
ADMIN_EMAIL=may@shop.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=แอดมินเมย์

# Facebook App Settings (1 Meta App handles all Facebook Pages b1-b5)
FB_VERIFY_TOKEN=omnichannel_fb_verify_token_dev
FB_APP_SECRET=dev_fb_app_secret_change_in_prod

# Live LINE / Facebook API Delivery ("true" to send/download real messages & media)
LIVE_DELIVERY_ENABLED=false

# Gemini AI Vision (leave blank for local Mock AI mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare R2 Cloud Storage (recommended for 500K+ messages/month; leave blank for local disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
